{
    "name": "hereby",
    "version": "1.15.2",
    "description": "A simple task runner",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jakebailey/hereby.git"
    },
    "type": "module",
    "bin": {
        "hereby": "bin/hereby.js"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./cli": "./dist/cli.js",
        "./package.json": "./package.json"
    },
    "author": "Jake Bailey",
    "license": "MIT",
    "keywords": [
        "hereby",
        "herebyfile",
        "task",
        "runner",
        "build",
        "gulp",
        "make",
        "makefile"
    ],
    "engines": {
        "node": ">= 12.20"
    },
    "preferUnplugged": true,
    "files": [
        "README.md",
        "LICENSE",
        "./dist/**/*.js",
        "!**/__tests__/**",
        "./dist/index.d.ts"
    ],
    "devDependencies": {
        "@changesets/cli": "^3.0.0",
        "@dprint/json": "^0.23.0",
        "@dprint/markdown": "^0.22.1",
        "@dprint/typescript": "^0.96.1",
        "@types/node": "^26.2.0",
        "dprint": "^0.55.2",
        "dprint-plugin-yaml": "^0.6.0",
        "monocart-coverage-reports": "^2.12.12",
        "oxlint": "^1.78.0",
        "oxlint-tsgolint": "^7.0.2001",
        "typescript": "^7.0.2"
    },
    "packageManager": "npm@12.0.2+sha512.b885e890b9418fa1693544d05f53e64f9a73ec194837d4258b15fecdd692347b1dd2a517b1b0cbaf9d31cd8e92c3b70956bd2ecc72833a57b4b3098f5bfa7943",
    "scripts": {
        "ci": "npm ci",
        "build": "tsc",
        "lint": "oxlint --type-aware",
        "watch": "tsc --watch",
        "test": "node dist/__tests__/runTests.js",
        "coverage": "mcr node dist/__tests__/runTests.js",
        "prepack": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && npm run build",
        "version": "changeset version && npm install"
    },
    "allowScripts": {
        "dprint@0.55.2": true
    }
}
